<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ND Dynamic Section</masterLabel>
    <description>Configurable detail section. Open "Section Config Builder" from the App Launcher to build its configuration, then paste the result into Field JSON Configuration.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>

            <!-- ONE property, and it has to stay that way.

                 Everything the section needs is in this JSON: field rows plus the title,
                 icon, colours, layout and header alert. The instructions live in the
                 description because that is the ONLY place text can go in an App Builder
                 property panel — there is no label-only or help-only property type, so any
                 attempt to add guidance as its own entry produces an input box nobody
                 should type in.

                 Adding a property here is also very hard to undo: the platform refuses to
                 remove a property tag while the component is on any Lightning page, even
                 with every value cleared, so it takes taking the component off all 8 pages,
                 deploying, removing the tag, then putting the pages back. That was done
                 twice — once for the ten legacy section properties, once for a well-meant
                 "set up here" box that turned out to be exactly the input nobody should
                 type in. Do not add a third. -->
            <property name="ND_jsonConfigString" type="String"
                      label="Field JSON Configuration"
                      description="Open the App Launcher and choose &quot;Section Config Builder&quot; to set up how this section should look — which fields it shows, the title, icon, colours and layout — then click Copy JSON there and paste the result here. You can type in this box directly, but nothing checks it: a mistyped setting is simply ignored, with no warning on the page."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
