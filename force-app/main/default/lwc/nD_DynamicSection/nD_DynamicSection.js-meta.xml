<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>ND Dynamic Section</masterLabel>
    <description>Configurable detail section. Open "Section Config Builder" from the App Launcher to build its configuration, then paste the result into Field JSON Configuration.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <!-- Experience Cloud. lightningCommunity__Page puts the component in the
             Experience Builder palette; lightningCommunity__Default is what lets it have
             properties there. Targets are additive, so the Lightning record pages this
             already sits on are untouched. -->
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>

            <!-- ONE property, and it has to stay that way.

                 Everything the section needs is in this JSON: field rows plus the title,
                 icon, colours, layout and header alert. The instructions live in the
                 description because that is the ONLY place text can go in an App Builder
                 property panel — there is no label-only or help-only property type, so any
                 attempt to add guidance as its own entry produces an input box nobody
                 should type in.

                 Adding a property here is also very hard to undo: the platform refuses to
                 remove a property tag while the component is on any Lightning page, even
                 with every value cleared, so it takes taking the component off all 8 pages,
                 deploying, removing the tag, then putting the pages back. That was done
                 twice — once for the ten legacy section properties, once for a well-meant
                 "set up here" box that turned out to be exactly the input nobody should
                 type in. Do not add a third. -->
            <!-- Kept short on purpose: Salesforce appends its own paragraph about custom
                 labels to every description, so a long one becomes a wall of text. The full
                 instruction is in the card itself, which is where it is actually needed. -->
            <property name="ND_jsonConfigString" type="String"
                      label="Field JSON Configuration"
                      description="Built by the Section Config Builder (App Launcher). Paste its Copy JSON output here."/>
        </targetConfig>

        <!-- Experience Cloud (Aura site, e.g. the AvioBook Customer Portal).

             A site does NOT inject recordId or objectApiName the way a Lightning record
             page does, so both have to be declared here and bound to {!recordId} /
             {!objectApiName} in the Experience Builder property panel. Without them
             nd_wireFields has no object to build a field list against and the card comes
             up empty — which looks like a broken component rather than a missing binding.

             The same warning as above applies to these three: once the component is on a
             portal page the platform will not let the tags be removed without stripping
             it from that page first. These are the minimum a site instance needs. Do not
             add a fourth.

             Nothing else is needed for the portal. Every widget that calls Apex — the
             owner picker and "take it!", isOpenProblem, isEmailList, childRollup — is
             opt-in per row, so a portal config that omits those rows makes no Apex call
             at all and needs no class access, permission set or profile change. Rows
             marked read-only cannot make the card dirty, so Save and Cancel never
             render either. -->
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String"
                      label="Record Id"
                      default="{!recordId}"/>
            <!-- ⚠️ A LITERAL object name, NOT {!objectApiName}. Salesforce documents that
                 expression as resolving "only when you place or invoke the component in an
                 explicit record context" and "only for components where the {!objectApiName}
                 is in the route" — and a portal route is /<prefix>/s/case/<id>, whose segment
                 is the object's URL name, not its API name. So it silently arrives unset, and
                 one missing value blanks the WHOLE card: no describe means nd_wireFields
                 returns undefined and never fires getRecord, while
                 lightning-record-edit-form cannot load either. Labels still render from the
                 JSON, so it looks like a component that loaded and found nothing rather than
                 one that was never told its object. Cost an afternoon in UAT on 2026-09-04.
                 {!recordId} above has no such caveat and does resolve. -->
            <property name="objectApiName" type="String"
                      label="Object API Name"
                      default="Case"
                      description="The object's API name, typed literally — Case. Change it if this page is for another object. Do NOT use {!objectApiName}: it only resolves when the API name is in the page route, and when it fails the whole card renders empty."/>
            <property name="ND_jsonConfigString" type="String"
                      label="Field JSON Configuration"
                      description="Built by the Section Config Builder (App Launcher, in Salesforce — not in the site). Paste its Copy JSON output here."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
